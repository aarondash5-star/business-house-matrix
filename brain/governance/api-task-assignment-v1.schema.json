{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aarondash5-star/business-house-matrix/blob/main/brain/governance/api-task-assignment-v1.schema.json",
  "title": "Business House Matrix third-party AI task assignment packet v1 (record only)",
  "description": "Versioned policy contract for an approved departmental task. Validation does NOT authorize or initiate inference, spending, provider activation, runtime changes, release or worker dispatch. Apply independently with the central owner-approved task envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_version",
    "task_id",
    "owner_envelope_ref",
    "department",
    "project_id",
    "tenant_id",
    "idempotency_key",
    "baseline_sha256",
    "task_profile",
    "objective",
    "input_evidence",
    "allowed_paths",
    "forbidden_effects",
    "data_policy",
    "routing_policy",
    "budget",
    "qa",
    "reporting"
  ],
  "properties": {
    "packet_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 6,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "owner_envelope_ref": {
      "type": "string",
      "minLength": 8,
      "maxLength": 400
    },
    "department": {
      "enum": [
        "concept",
        "design",
        "development",
        "qa_qc",
        "marketing",
        "sales",
        "accounts",
        "support",
        "evolution"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 150
    },
    "tenant_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 150
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 10,
      "maxLength": 220
    },
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_profile": {
      "enum": [
        "deterministic_check",
        "source_retrieval",
        "research_extraction",
        "structured_analysis",
        "narrow_code_patch",
        "multifile_code_patch",
        "design_draft",
        "copy_draft",
        "vision_analysis",
        "security_review",
        "qa_generation",
        "other_approved"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 15,
      "maxLength": 4000
    },
    "input_evidence": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256",
          "trust"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "trust": {
            "enum": [
              "verified_internal",
              "verified_public",
              "approved_project_rag",
              "untrusted_external"
            ]
          },
          "line_range": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "license_ref": {
            "type": "string",
            "minLength": 4,
            "maxLength": 300
          }
        }
      }
    },
    "allowed_paths": {
      "type": "array",
      "maxItems": 80,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "forbidden_effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 120
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "external_transfer_authorized",
        "redaction_verified"
      ],
      "properties": {
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "external_transfer_authorized": {
          "type": "boolean",
          "description": "Requires independently verified authorization for this project, tenant, provider and content."
        },
        "redaction_verified": {
          "type": "boolean"
        },
        "retention_review_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "data_residency_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "privacy_approval_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        }
      }
    },
    "routing_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "provider_ids",
        "model_ids",
        "license_decision",
        "batch_allowed",
        "cache_allowed"
      ],
      "properties": {
        "mode": {
          "enum": [
            "deterministic_first",
            "local_only",
            "external"
          ]
        },
        "provider_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          }
        },
        "model_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          }
        },
        "license_decision": {
          "enum": [
            "osi_verified",
            "owner_exception",
            "not_applicable"
          ]
        },
        "license_receipt_ref": {
          "type": "string",
          "minLength": 4,
          "maxLength": 350
        },
        "provider_registry_ref": {
          "type": "string",
          "minLength": 4,
          "maxLength": 350
        },
        "account_group": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "batch_allowed": {
          "type": "boolean"
        },
        "cache_allowed": {
          "type": "boolean"
        },
        "deadline_utc": {
          "type": "string",
          "format": "date-time"
        },
        "rate_snapshot_ref": {
          "type": "string",
          "minLength": 4,
          "maxLength": 350
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "paid_cap",
        "max_input_tokens",
        "max_output_tokens",
        "max_total_attempts",
        "reserved_amount"
      ],
      "properties": {
        "currency": {
          "enum": [
            "INR",
            "USD"
          ]
        },
        "paid_cap": {
          "type": "number",
          "minimum": 0
        },
        "reserved_amount": {
          "type": "number",
          "minimum": 0
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_total_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "per_request_cap": {
          "type": "number",
          "minimum": 0
        },
        "per_day_cap": {
          "type": "number",
          "minimum": 0
        },
        "per_project_cap": {
          "type": "number",
          "minimum": 0
        },
        "per_department_cap": {
          "type": "number",
          "minimum": 0
        },
        "per_account_group_cap": {
          "type": "number",
          "minimum": 0
        },
        "per_sprint_cap": {
          "type": "number",
          "minimum": 0
        },
        "max_external_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "price_snapshot_ref": {
          "type": "string",
          "minLength": 4,
          "maxLength": 350
        },
        "fx_basis_ref": {
          "type": "string",
          "minLength": 4,
          "maxLength": 350
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "test_refs",
        "acceptance"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 130
        },
        "test_refs": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 350
          }
        },
        "test_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "maxProperties": 60
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 35,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          }
        },
        "independent_reviewer_required": {
          "const": true
        },
        "rollback_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 400
        },
        "max_repairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_ref",
        "release_mode"
      ],
      "properties": {
        "receipt_ref": {
          "type": "string",
          "minLength": 4,
          "maxLength": 500
        },
        "release_mode": {
          "enum": [
            "manual",
            "separately_authorized_governed",
            "none"
          ]
        },
        "allow_publishing": {
          "const": false
        },
        "allow_production_deployment": {
          "const": false
        },
        "cost_reporting_ref": {
          "type": "string",
          "minLength": 4,
          "maxLength": 400
        },
        "status": {
          "enum": [
            "record_only",
            "waiting_authorization",
            "approved_not_dispatched",
            "dispatched",
            "blocked",
            "qa_pass",
            "qa_fail",
            "integrated",
            "quarantined",
            "completed"
          ]
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 120
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "routing_policy": {
            "properties": {
              "mode": {
                "const": "external"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "routing_policy"
        ]
      },
      "then": {
        "properties": {
          "routing_policy": {
            "properties": {
              "provider_ids": {
                "minItems": 1
              },
              "model_ids": {
                "minItems": 1
              },
              "license_decision": {
                "enum": [
                  "osi_verified",
                  "owner_exception"
                ]
              }
            }
          },
          "data_policy": {
            "properties": {
              "external_transfer_authorized": {
                "const": true
              },
              "redaction_verified": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "$comment": "JSON Schema cannot enforce provider billing, source hash correctness, reserve<=cap, task envelope authority, independent reviewer identity, or actual runtime status. The SOP requires separate authenticated policy checks. No dispatcher is included."
}
