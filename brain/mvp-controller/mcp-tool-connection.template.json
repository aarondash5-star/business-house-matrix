{
  "id": "mcp-fetch-docs",
  "provider": "mcp-server-fetch",
  "type": "mcp",
  "transport": "stdio",
  "enabled": true,
  "tool": "fetch",
  "self_hosted": true,
  "open_source_license_reviewed": true,
  "license": "MIT",
  "paid_fallback_allowed": false,
  "public_only": true,
  "private_network_allowed": false,
  "quota_group": "matrix-dev-docs",
  "conservative_daily_requests": 50,
  "conservative_minute_requests": 3,
  "cooldown_seconds": 900,
  "preference": {
    "documentation": 10,
    "repository_context": 20
  },
  "notes": "Source-restricted external MCP documentation; no user-selected shell actions"
}
