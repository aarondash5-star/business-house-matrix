[Unit]
Description=Shaadi Aunty fixed-recipe Blender/OpenCode art worker (review-only)
After=default.target

[Service]
Type=oneshot
WorkingDirectory=%h/matrix-controller/art-worker-v1
ExecStart=/usr/bin/python3 -B %h/matrix-controller/art-worker-v1/worker.py tick
TimeoutStartSec=140
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=%h/matrix-controller/art-worker-v1
ReadWritePaths=%h/shaadi-quality-v1-art-20261025/projects/shaadi-aunty-dodge/art/quality-v1/iterations
ReadWritePaths=%h/matrix-game-toolkit-20261025/third_party/blender-xdg-config
ReadWritePaths=%h/.local/share
ReadWritePaths=%h/.cache
UMask=0077
MemoryMax=5G
CPUQuota=170%
TasksMax=96
