# Copy to .env on isolated pilot host; never commit populated .env.
# Replace placeholder with reviewed upstream pinned release tag or immutable digest.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:REPLACE_WITH_REVIEWED_VERSION
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_64_HEX
# Temporarily set True ONLY when first admin account is created over loopback;
# return to False immediately afterward and restart the app.
ENABLE_SIGNUP=False
