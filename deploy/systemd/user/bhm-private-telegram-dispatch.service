[Unit]
Description=Business House Matrix signed private Telegram event dispatcher
Documentation=https://github.com/aarondash5-star/business-house-matrix
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/state/business-house-matrix
ProtectHome=no
MemoryMax=256M
CPUQuota=75%
TimeoutStartSec=40
EnvironmentFile=-%h/.config/business-house-matrix/private-telegram.env
ExecStart=/usr/bin/python3 -B %h/matrix-gate-s-supervisor-20261023/brain/automation/private_telegram_sender.py dispatch

[Install]
WantedBy=default.target
